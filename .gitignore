# Ignored files for Hydrus Telegram Bot

# ----- AI rules -----
AGENTS.md

# ----- Runtime artifacts -----
bot.pid
bot.lock

# ----- Logs folder -----
logs/*
!logs/.gitkeep

# ----- Queue folder (media + metadata) -----
# queue/* already covers every queued file, so repo-wide *.png / *.jpg / *.mp4
# globs are unnecessary here and would also swallow images added elsewhere,
# such as screenshots in documentation.
queue/*
!queue/.gitkeep

# ----- Virtual environments & IDE settings -----
# Both names are in use: .venv on macOS, venv on the Windows host.
/.venv/
/venv/
/.idea/
/.vscode/

# ----- Configuration files -----
config/config.json
config/config.json.dev
config/config.json.prod
config-dev.bat
config-prod.bat

# ----- OS Specific files -----
# macOS
.DS_Store
._*
.Spotlight*
.Trashes
# Windows
ehthumbs.db
Thumbs.db
start.bat

# ----- Python artifacts -----
__pycache__/
*.py[cod]
Code Review.md
