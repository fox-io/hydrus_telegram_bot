<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened ImageMagick policy for hydrus_telegram_bot.

  The bot loads this file automatically: modules/telegram_manager.py points
  MAGICK_CONFIGURE_PATH at this directory before importing Wand, so no manual
  install is required on any machine. Set MAGICK_CONFIGURE_PATH yourself to
  override that.

  Installing it system-wide as well is optional, and only matters if you also run
  `magick` by hand outside the bot. scripts/install_imagemagick_policy.py does
  that, with a backup.

  Why this exists: the bot posts files downloaded from the internet, so
  ImageMagick decodes attacker-influenced input. The resource limits the bot sets
  at startup (TelegramManager.apply_imagemagick_limits) cover exhaustion attacks,
  but do nothing about the coder and delegate classes below, which are the ones
  with a history of remote code execution and SSRF. Without this policy,
  ImageMagick will genuinely issue an outbound HTTP request for an image that
  asks it to.

  The bot only ever needs to read and resize ordinary raster images, so
  everything else can be denied without affecting it.

  Note: this deliberately omits the DOCTYPE that ImageMagick's stock policy.xml
  carries. That DTD declares attributes as type NCName, which is not a legal DTD
  attribute type, so strict XML parsers reject the file. ImageMagick does not
  require it.
-->
<policymap>
  <!-- Coders that execute or fetch rather than decode pixels. The MSL and MVG
       coders interpret scripting languages; URL/HTTPS/FTP make the decoder issue
       network requests, which is an SSRF primitive. -->
  <policy domain="coder" rights="none" pattern="MSL" />
  <policy domain="coder" rights="none" pattern="MVG" />
  <policy domain="coder" rights="none" pattern="URL" />
  <policy domain="coder" rights="none" pattern="HTTPS" />
  <policy domain="coder" rights="none" pattern="HTTP" />
  <policy domain="coder" rights="none" pattern="FTP" />
  <policy domain="coder" rights="none" pattern="EPHEMERAL" />
  <policy domain="coder" rights="none" pattern="TEXT" />
  <policy domain="coder" rights="none" pattern="SHOW" />
  <policy domain="coder" rights="none" pattern="WIN" />
  <policy domain="coder" rights="none" pattern="PLT" />
  <policy domain="coder" rights="none" pattern="PS" />
  <policy domain="coder" rights="none" pattern="PS2" />
  <policy domain="coder" rights="none" pattern="PS3" />
  <policy domain="coder" rights="none" pattern="EPS" />
  <policy domain="coder" rights="none" pattern="PDF" />
  <policy domain="coder" rights="none" pattern="XPS" />

  <!-- Delegates shell out to external programs. The bot needs none of them. -->
  <policy domain="delegate" rights="none" pattern="*" />

  <!-- Indirect reads (@file syntax) let a crafted filename pull in local files. -->
  <policy domain="path" rights="none" pattern="@*" />

  <!-- Backstop resource limits. The bot also sets these at startup, but these
       apply even to ImageMagick invoked outside the bot. -->
  <policy domain="resource" name="memory" value="256MiB" />
  <policy domain="resource" name="map" value="512MiB" />
  <policy domain="resource" name="disk" value="1GiB" />
  <policy domain="resource" name="area" value="256MP" />
  <policy domain="resource" name="width" value="50KP" />
  <policy domain="resource" name="height" value="50KP" />
  <policy domain="resource" name="time" value="60" />
  <policy domain="resource" name="thread" value="1" />
</policymap>
